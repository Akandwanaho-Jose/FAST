# Copy this file to .env and keep the real .env local and uncommitted.
# Quote values containing spaces, #, =, quotes, or other special characters.

APP_ENV=development
APP_DEBUG=true
APP_NAME="FAST Website"
# Fixed public origin, used to build links in outbound email - must match
# how the site is actually reached (scheme + host + base path).
APP_URL=http://localhost/FAST/public
SESSION_NAME=fast_session
SESSION_LIFETIME_MINUTES=120
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
MAX_IMAGE_UPLOAD_MB=20

# Password-reset emails, sent via the Brevo transactional email API
# (https://app.brevo.com/settings/keys/api). MAIL_FROM_ADDRESS must be a
# verified sender in that Brevo account or sends will be rejected.
BREVO_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="FAST Website"

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fast_website_db
DB_USERNAME=fast_app
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
